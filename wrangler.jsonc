{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "bethel-sc-websitev2",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
